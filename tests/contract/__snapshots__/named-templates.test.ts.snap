exports[`named environment templates > agentx-staging-slack is unchanged 1`] = `
{
  "Conditions": {
    "ClassifierOnBedrock": {
      "Fn::Equals": [
        {
          "Ref": "GateClassifierProvider",
        },
        "amazon-bedrock",
      ],
    },
    "HasPermissionsBoundary": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PermissionsBoundaryArn",
            },
            "",
          ],
        },
      ],
    },
    "OrchestratorOnBedrock": {
      "Fn::Equals": [
        {
          "Ref": "ModelProvider",
        },
        "amazon-bedrock",
      ],
    },
  },
  "Description": "Hosted AgentX Slack orchestrator on ECS Fargate",
  "Outputs": {
    "ClusterName": {
      "Value": {
        "Ref": "Cluster",
      },
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name",
        ],
      },
    },
  },
  "Parameters": {
    "AnthropicSecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw Anthropic API key",
      "Type": "String",
    },
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
    "ControlPlaneUrl": {
      "AllowedPattern": "^https://.+$",
      "Type": "String",
    },
    "GateClassifierModelId": {
      "Default": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "Description": "Small model the action gate asks whether a member asked for a change",
      "Type": "String",
    },
    "GateClassifierProvider": {
      "AllowedValues": [
        "amazon-bedrock",
        "openrouter",
        "anthropic",
        "openai",
      ],
      "Default": "amazon-bedrock",
      "Type": "String",
    },
    "ModelId": {
      "Default": "us.anthropic.claude-sonnet-4-6",
      "Type": "String",
    },
    "ModelProvider": {
      "Default": "amazon-bedrock",
      "Type": "String",
    },
    "OpenAISecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw OpenAI API key",
      "Type": "String",
    },
    "OpenRouterProviders": {
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9_/-]{0,79}(,[a-z0-9][a-z0-9_/-]{0,79})*$",
      "Default": "",
      "Description": "Optional comma-separated OpenRouter provider allowlist; fallbacks are disabled",
      "Type": "String",
    },
    "OpenRouterSecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw OpenRouter API key",
      "Type": "String",
    },
    "OperatorAlertsTopicArn": {
      "Description": "The environment's alert topic, the control plane's OperatorAlertsTopicArn output",
      "Type": "String",
    },
    "OrchestratorImageUri": {
      "AllowedPattern": "^.+@sha256:[a-f0-9]{64}$",
      "Description": "Immutable private ECR linux/arm64 Slack orchestrator image URI",
      "Type": "String",
    },
    "PermissionsBoundaryArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:iam::[0-9]{12}:policy/.+$",
      "Default": "",
      "Description": "Optional IAM permissions boundary policy ARN applied to every role this environment creates; empty uses the default boundary",
      "Type": "String",
    },
    "PrivateSubnetIds": {
      "Description": "Private subnets with NAT egress, such as AgentXProductionFoundation's PrivateSubnetIds",
      "Type": "List<AWS::EC2::Subnet::Id>",
    },
    "SlackRequestQueueUrl": {
      "AllowedPattern": "^https://sqs\\..+\\.fifo$",
      "Type": "String",
    },
    "SlackSecretArn": {
      "AllowedPattern": "^arn:aws(-[^:]+)?:secretsmanager:.+$",
      "Type": "String",
    },
    "SlackThreadsTableName": {
      "MinLength": 3,
      "Type": "String",
    },
    "SlowTurnMinutes": {
      "Default": 5,
