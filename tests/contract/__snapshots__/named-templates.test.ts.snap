    "ConnectorBrokenAlarmBE25C37B": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "A connector's discovery failed or a vendor changed an approved tool's schema. Check the broker logs for connector metrics and connector.* events.",
        "AlarmName": "agentx-staging-ConnectorBroken",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "FILL(discovery, 0) + FILL(drift, 0)",
            "Id": "expr_1",
            "Label": "Connector discovery failures and schema drift",
            "ReturnData": true,
          },
          {
            "Id": "discovery",
            "MetricStat": {
              "Metric": {
                "MetricName": "ConnectorDiscoveryFailed",
                "Namespace": "AgentX/staging",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "drift",
            "MetricStat": {
              "Metric": {
                "MetricName": "ConnectorSchemaDrift",
                "Namespace": "AgentX/staging",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
