    },
    "TurnRecordsTableName": {
      "Description": "TurnRecordsTableName output of AgentXControlPlane",
      "MinLength": 3,
      "Type": "String",
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
    },
  },
  "Resources": {
    "BedrockThrottlingAlarm709CDF3A": {
      "Condition": "OrchestratorOnBedrock",
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
        "AlarmDescription": "Amazon Bedrock throttled the orchestrator model at least 5 times in 5 minutes. Ask for a higher quota in Service Quotas, or choose another model.",
        "AlarmName": "agentx-staging-BedrockThrottling",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "ModelId",
            "Value": {
              "Ref": "ModelId",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "InvocationThrottles",
        "Namespace": "AWS/Bedrock",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Threshold": 5,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "CheckerFailuresAlarmC6E35EC0": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
