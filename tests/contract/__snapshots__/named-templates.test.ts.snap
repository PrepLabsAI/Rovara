                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":root",
                    ],
                  ],
                },
              },
              "Resource": "*",
            },
            {
              "Action": "kms:Sign",
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "DispatcherServiceRole904BCD09",
                      "Arn",
                    ],
                  },
                },
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": "*",
              "Sid": "SignOnlyAsDispatcher",
            },
          ],
          "Version": "2012-10-17",
