    "DeveloperSignInTokenKey9F4912A4": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "Description": "Signs AgentX staging developer access tokens",
        "KeyPolicy": {
          "Statement": [
            {
              "Action": "kms:*",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":root",
                    ],
                  ],
                },
              },
              "Resource": "*",
            },
            {
              "Action": [
                "kms:Sign",
                "kms:GetPublicKey",
              ],
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "DeveloperSignInFunctionServiceRole47322E59",
                      "Arn",
                    ],
                  },
                },
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": "*",
              "Sid": "SignAndGetPublicKeyOnlyAsDeveloperIdentity",
            },
          ],
          "Version": "2012-10-17",
        },
        "KeySpec": "RSA_2048",
        "KeyUsage": "SIGN_VERIFY",
        "PendingWindowInDays": 7,
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
      },
      "Type": "AWS::KMS::Key",
      "UpdateReplacePolicy": "Delete",
    },
