    },
    "Cluster": {
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled",
          },
        ],
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
          {
            "Key": "Application",
            "Value": "AgentX",
          },
        ],
      },
      "Type": "AWS::ECS::Cluster",
    },
    "ExecutionRole605A040B": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId",
                  },
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "Pulls the AgentX Slack orchestrator image and writes its logs",
