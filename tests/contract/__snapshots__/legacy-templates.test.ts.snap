    "SecurityGroup": {
      "Properties": {
        "GroupDescription": "AgentX Slack orchestrator: no ingress and HTTPS-only egress",
        "SecurityGroupEgress": [
          {
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS to Slack, Amazon Bedrock, the AgentX control plane, and AWS APIs",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443,
          },
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "AgentX",
          },
        ],
        "VpcId": {
          "Ref": "VpcId",
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "Service": {
      "Properties": {
        "Cluster": {
          "Ref": "Cluster",
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true,
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
        },
        "DesiredCount": 1,
        "EnableExecuteCommand": false,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              {
                "Fn::GetAtt": [
                  "SecurityGroup",
                  "GroupId",
                ],
              },
            ],
            "Subnets": {
              "Ref": "PrivateSubnetIds",
            },
          },
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition",
        },
      },
      "Type": "AWS::ECS::Service",
    },
    "TaskDefinition": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": "us-east-1",
              },
              {
                "Name": "CONTROL_PLANE_URL",
                "Value": {
                  "Ref": "ControlPlaneUrl",
                },
              },
              {
                "Name": "SLACK_REQUEST_QUEUE_URL",
                "Value": {
                  "Ref": "SlackRequestQueueUrl",
                },
              },
              {
                "Name": "SLACK_THREADS_TABLE_NAME",
                "Value": {
                  "Ref": "SlackThreadsTableName",
                },
              },
              {
                "Name": "THREAD_SESSION_BUCKET_NAME",
                "Value": {
                  "Ref": "ThreadSessionBucketName",
                },
              },
              {
                "Name": "TURN_RECORDS_TABLE_NAME",
                "Value": {
                  "Ref": "TurnRecordsTableName",
                },
              },
              {
                "Name": "SLACK_SECRET_ARN",
                "Value": {
                  "Ref": "SlackSecretArn",
                },
              },
              {
                "Name": "AGENTX_ORCHESTRATOR_PROVIDER",
                "Value": {
                  "Ref": "ModelProvider",
                },
              },
              {
                "Name": "AGENTX_ORCHESTRATOR_MODEL",
                "Value": {
                  "Ref": "ModelId",
                },
              },
              {
                "Name": "AGENTX_OPENROUTER_SECRET_ARN",
                "Value": {
                  "Ref": "OpenRouterSecretArn",
                },
              },
              {
                "Name": "AGENTX_ANTHROPIC_SECRET_ARN",
                "Value": {
                  "Ref": "AnthropicSecretArn",
                },
              },
              {
                "Name": "AGENTX_OPENAI_SECRET_ARN",
                "Value": {
                  "Ref": "OpenAISecretArn",
                },
              },
              {
                "Name": "AGENTX_OPENROUTER_PROVIDERS",
                "Value": {
                  "Ref": "OpenRouterProviders",
                },
              },
              {
                "Name": "AGENTX_GATE_CLASSIFIER_PROVIDER",
                "Value": {
                  "Ref": "GateClassifierProvider",
                },
              },
              {
                "Name": "AGENTX_GATE_CLASSIFIER_MODEL",
                "Value": {
                  "Ref": "GateClassifierModelId",
                },
              },
            ],
            "Essential": true,
            "Image": {
              "Ref": "OrchestratorImageUri",
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs6819BB44",
                },
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "orchestrator",
              },
            },
            "Name": "orchestrator",
            "StopTimeout": 120,
          },
        ],
        "Cpu": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole605A040B",
            "Arn",
          ],
        },
        "Family": "agentx-slack-orchestrator",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE",
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX",
        },
        "TaskRoleArn": {
          "Ref": "TaskRoleArn",
        },
      },
      "Type": "AWS::ECS::TaskDefinition",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
