    "ReleaseBuild2D3CBBB5": {
      "Properties": {
        "Artifacts": {
          "Type": "CODEPIPELINE",
        },
        "Cache": {
          "Modes": [
            "LOCAL_DOCKER_LAYER_CACHE",
          ],
          "Type": "LOCAL",
        },
        "ConcurrentBuildLimit": 1,
        "Description": "Runs npm run release:prod for AgentX mainline commits",
        "EncryptionKey": "alias/aws/s3",
        "Environment": {
          "ComputeType": "BUILD_GENERAL1_LARGE",
          "Image": "aws/codebuild/amazonlinux-aarch64-standard:3.0",
          "ImagePullCredentialsType": "CODEBUILD",
          "PrivilegedMode": true,
          "Type": "ARM_CONTAINER",
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "GroupName": {
              "Ref": "ReleaseBuildLogsD2C04AA9",
            },
            "Status": "ENABLED",
          },
        },
        "Name": "release-agentx-production",
        "ServiceRole": {
          "Fn::GetAtt": [
            "ReleaseBuildRole789F2E69",
            "Arn",
          ],
        },
        "Source": {
          "BuildSpec": "{
  "version": "0.2",
  "env": {
    "shell": "bash",
    "variables": {
      "NODE_OPTIONS": "--max-old-space-size=8192",
      "CODE_RELEASE": "run",
      "PIPELINE_MODE": "release",
      "CODE_ROLLBACK_TARGET": "none",
      "AWS_CLI_VERSION": "2.36.47",
      "GITLEAKS_VERSION": "8.30.1",
      "GITLEAKS_SHA256": "<asset-hash>"
    }
  },
  "phases": {
    "install": {
      "commands": [
        "case \\"$CODE_RELEASE\\" in run|skip) ;; *) echo \\"CODE_RELEASE must be run or skip, got: $CODE_RELEASE\\" >&2; exit 1;; esac",
        "[ \\"$CODE_RELEASE\\" != skip ] || echo \\"CODE_RELEASE=skip: this run releases Cloud only; Code is not built or deployed\\"",
        "case \\"$PIPELINE_MODE\\" in release|adopt|rollback) ;; *) echo \\"PIPELINE_MODE must be release, adopt or rollback, got: $PIPELINE_MODE\\" >&2; exit 1;; esac",
        "if [ \\"$PIPELINE_MODE\\" = rollback ] && [ \\"$CODE_ROLLBACK_TARGET\\" != none ]; then [[ \\"$CODE_ROLLBACK_TARGET\\" =~ ^[0-9a-f]{40}$ ]] || { echo \\"CODE_ROLLBACK_TARGET must be a full 40-character commit id, or none, got: $CODE_ROLLBACK_TARGET\\" >&2; exit 1; }; echo \\"NOTE: Code rollback target is $CODE_ROLLBACK_TARGET\\"; elif [ \\"$PIPELINE_MODE\\" != rollback ] && [ \\"$CODE_ROLLBACK_TARGET\\" != none ]; then echo \\"CODE_ROLLBACK_TARGET is only for PIPELINE_MODE=rollback; got $CODE_ROLLBACK_TARGET in mode $PIPELINE_MODE\\" >&2; exit 1; fi",
        "if [ \\"$PIPELINE_MODE\\" = rollback ]; then if [ \\"$CODE_ROLLBACK_TARGET\\" = none ]; then [ \\"$CODE_RELEASE\\" = skip ] || { echo \\"a rollback run with no Code rollback target does not release Code, but CODE_RELEASE is $CODE_RELEASE\\" >&2; exit 1; }; else [ \\"$CODE_RELEASE\\" = run ] || { echo \\"a Code rollback target was given but CODE_RELEASE is $CODE_RELEASE, so Code would not be rolled back\\" >&2; exit 1; }; fi; fi",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { HIST_VALUE=\\"$(aws ssm get-parameter --name /agentx/release/code-history/production --query Parameter.Value --output text)\\" || { echo \\"the Code release history could not be read; Code is not rolled back\\" >&2; exit 1; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { HIST_FLAT=\\"$(printf '%s' \\"$HIST_VALUE\\" | tr -d ' \\\\t\\\\r\\\\n')\\"; HIST_RE='^\\\\[(\\"[0-9a-f]{40}\\"(,\\"[0-9a-f]{40}\\")*)?\\\\]$'; [[ \\"$HIST_FLAT\\" =~ $HIST_RE ]] || { echo \\"the Code release history is not a list of commits; Code is not rolled back\\" >&2; exit 1; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { [[ \\"$HIST_FLAT\\" == *\\"\\\\\\"$CODE_ROLLBACK_TARGET\\\\\\"\\"* ]] || { echo \\"the rollback target is not in this stage's Code release history; Code is not rolled back\\" >&2; exit 1; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { git cat-file -e \\"$CODE_ROLLBACK_TARGET^{commit}\\" || { echo \\"the rollback target is not in this clone; Code is not rolled back\\" >&2; exit 1; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { git merge-base --is-ancestor \\"$CODE_ROLLBACK_TARGET\\" HEAD || { echo \\"the rollback target is not an ancestor of this run's commit; Code is not rolled back\\" >&2; exit 1; }; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { [ \\"$PIPELINE_MODE\\" != rollback ] || [ \\"$CODE_ROLLBACK_TARGET\\" = none ] || git checkout -q --detach \\"$CODE_ROLLBACK_TARGET\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { node_version=\\"$(cat .node-version)\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { node_archive=\\"node-v\${node_version}-linux-arm64.tar.xz\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { curl -fsSL -o \\"/tmp/\${node_archive}\\" \\"https://nodejs.org/dist/v\${node_version}/\${node_archive}\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { curl -fsSL \\"https://nodejs.org/dist/v\${node_version}/SHASUMS256.txt\\" | grep \\" \${node_archive}$\\" | (cd /tmp && sha256sum -c -); }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { mkdir -p /opt/node && tar -xJf \\"/tmp/\${node_archive}\\" -C /opt/node --strip-components=1; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { curl -fsSL -o /tmp/awscliv2.zip \\"https://awscli.amazonaws.com/awscli-exe-linux-aarch64-\${AWS_CLI_VERSION}.zip\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install --install-dir /opt/aws-cli --bin-dir /opt/aws-cli/bin; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { curl -fsSL -o /tmp/gitleaks.tar.gz \\"https://github.com/gitleaks/gitleaks/releases/download/v\${GITLEAKS_VERSION}/gitleaks_\${GITLEAKS_VERSION}_linux_arm64.tar.gz\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { echo \\"\${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz\\" | sha256sum -c -; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { mkdir -p /opt/gitleaks && tar -xzf /tmp/gitleaks.tar.gz -C /opt/gitleaks gitleaks; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { export PATH=\\"/opt/node/bin:/opt/aws-cli/bin:/opt/gitleaks:$PATH\\"; }",
        "[ \\"$CODE_RELEASE\\" = skip ] || { node --version && npm --version && aws --version && gitleaks version && docker buildx version; }"
      ]
    },
    "pre_build": {
      "commands": [
        "[ \\"$CODE_RELEASE\\" = skip ] || { npm ci; }"
      ]
    },
    "build": {
      "commands": [
        "if [ \\"$CODE_RELEASE\\" = skip ]; then mkdir -p cdk.out && printf '{\\"codeRelease\\":\\"skip\\"}\\\\n' > cdk.out/agentx-production-release.json; else if node scripts/release-ci-proof.ts --repository PrepLabsAI/Rovara --github-app-stack AgentXControlPlane --region \\"$AWS_REGION\\"; then RELEASE_CHECKS=--skip-checks; else RELEASE_CHECKS=; fi; npm run release:prod -- --region \\"$AWS_REGION\\" --reuse-unchanged-worker --require-existing-foundation $RELEASE_CHECKS && { if [ \\"$PIPELINE_MODE\\" = rollback ] && [ \\"$CODE_ROLLBACK_TARGET\\" != none ]; then RELEASED_SOURCE=\\"$CODE_ROLLBACK_TARGET\\"; else RELEASED_SOURCE=\\"$CODEBUILD_RESOLVED_SOURCE_VERSION\\"; fi; [[ \\"$RELEASED_SOURCE\\" =~ ^[0-9a-f]{40}$ ]] || { echo \\"the source version of this build is not a commit id; the release is not recorded\\" >&2; exit 1; }; HIST_ERR=\\"$(mktemp)\\" && { HIST_OLD=\\"$(aws ssm get-parameter --name /agentx/release/code-history/production --query Parameter.Value --output text 2>\\"$HIST_ERR\\")\\" || { grep -q ParameterNotFound \\"$HIST_ERR\\" && HIST_OLD=; } || { cat \\"$HIST_ERR\\" >&2; false; }; } && HIST_NEW=\\"$({ printf '%s\\\\n' \\"$RELEASED_SOURCE\\"; printf '%s\\\\n' \\"$HIST_OLD\\" | { grep -oE '\\"[0-9a-f]{40}\\"' || true; } | tr -d '\\"'; } | awk '!seen[$0]++' | head -n 10 | awk 'BEGIN{printf \\"[\\"} {printf \\"%s\\\\\\"%s\\\\\\"\\", (NR>1?\\",\\":\\"\\"), $0} END{printf \\"]\\"}')\\" && aws ssm put-parameter --name /agentx/release/code-history/production --type String --overwrite --value \\"$HIST_NEW\\" && aws ssm put-parameter --name /agentx/release/code-released/production --type String --overwrite --value \\"$RELEASED_SOURCE\\"; }; fi"
      ]
    }
  },
  "artifacts": {
    "files": [
      "cdk.out/agentx-production-release.json"
    ],
    "discard-paths": "yes"
  }
}",
          "Type": "CODEPIPELINE",
        },
        "TimeoutInMinutes": 120,
      },
      "Type": "AWS::CodeBuild::Project",
    },
