    "SessionsLostInstancesAlarm436CBE5A": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "A READY EC2 worker's instance disappeared; its session was stopped and its running operation failed. Check the reconciler's logs and the instance's EC2 history.",
        "AlarmName": "AgentXReconcilerLostInstances",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "ReconcilerLostInstances",
        "Namespace": "AgentX",
        "Period": 900,
