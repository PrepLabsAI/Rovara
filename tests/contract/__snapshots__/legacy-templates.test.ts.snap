    },
    "ChannelRequestQueueUrl": {
      "AllowedPattern": "^$|^https://sqs\\..+\\.fifo$",
      "Default": "",
      "Type": "String",
    },
    "CompanySignIn": {
      "AllowedValues": [
        "enabled",
        "disabled",
      ],
      "Default": "disabled",
      "Description": "The control plane's CompanySignIn switch, for the Slack service: enabled or disabled (agentx config set company.signIn sets both)",
      "Type": "String",
    },
    "ControlPlaneUrl": {
      "AllowedPattern": "^https://.+$",
      "Type": "String",
    },
    "GateClassifierModelId": {
      "Default": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "Description": "Small model the action gate asks whether a member asked for a change",
      "Type": "String",
    },
    "GateClassifierProvider": {
      "AllowedValues": [
        "amazon-bedrock",
        "openrouter",
        "anthropic",
        "openai",
      ],
      "Default": "amazon-bedrock",
