    "InvokeSigningKey2B33EC11": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "Description": "Signs AgentX production invocations to EC2 workers",
        "KeyPolicy": {
          "Statement": [
            {
              "Action": "kms:*",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":root",
                    ],
                  ],
                },
              },
              "Resource": "*",
            },
            {
              "Action": "kms:Sign",
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "DispatcherServiceRole904BCD09",
                      "Arn",
                    ],
                  },
                },
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": "*",
              "Sid": "SignOnlyAsDispatcher",
            },
          ],
          "Version": "2012-10-17",
        },
        "KeySpec": "ECC_NIST_P256",
        "KeyUsage": "SIGN_VERIFY",
        "PendingWindowInDays": 7,
      },
      "Type": "AWS::KMS::Key",
      "UpdateReplacePolicy": "Retain",
    },
    "InvokeSigningKeyAliasB29C73C1": {
      "Properties": {
        "AliasName": "alias/agentx/production/invoke-signing",
        "TargetKeyId": {
          "Fn::GetAtt": [
            "InvokeSigningKey2B33EC11",
