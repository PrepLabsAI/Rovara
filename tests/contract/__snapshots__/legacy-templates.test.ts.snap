    "ConnectorBrokenAlarmBE25C37B": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "A connector's discovery failed or a vendor changed an approved tool's schema. Check the broker logs for connector metrics and connector.* events.",
        "AlarmName": "AgentXConnectorBroken",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "FILL(discovery, 0) + FILL(drift, 0)",
            "Id": "expr_1",
            "Label": "Connector discovery failures and schema drift",
            "ReturnData": true,
          },
          {
            "Id": "discovery",
            "MetricStat": {
              "Metric": {
                "MetricName": "ConnectorDiscoveryFailed",
                "Namespace": "AgentX",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "drift",
            "MetricStat": {
              "Metric": {
                "MetricName": "ConnectorSchemaDrift",
                "Namespace": "AgentX",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ConnectorNotConnectedAlarmF2FDC428": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "A connector's vendor credential is missing, revoked or rejected. Check the broker logs for the connector, then reconnect it with agentx connectors.",
        "AlarmName": "AgentXConnectorNotConnected",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "ConnectorNotConnected",
        "Namespace": "AgentX",
        "Period": 300,
        "Statistic": "Sum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
