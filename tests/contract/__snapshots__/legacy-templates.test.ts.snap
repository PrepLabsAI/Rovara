        },
        "ConcurrentBuildLimit": 1,
        "Description": "Runs the port guard on the Code tree with the private name list, before the Beta stage's gates and writes (L14)",
        "EncryptionKey": "alias/aws/s3",
        "Environment": {
          "ComputeType": "BUILD_GENERAL1_MEDIUM",
          "Image": "aws/codebuild/amazonlinux-aarch64-standard:3.0",
          "ImagePullCredentialsType": "CODEBUILD",
          "PrivilegedMode": false,
          "Type": "ARM_CONTAINER",
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "GroupName": {
              "Ref": "ReleaseBuildLogsD2C04AA9",
            },
            "Status": "ENABLED",
          },
        },
        "Name": "release-agentx-preflight-beta",
        "ServiceRole": {
          "Fn::GetAtt": [
            "BetaCodePreflightRole898B1F2B",
            "Arn",
          ],
        },
        "Source": {
          "BuildSpec": {
            "Fn::Join": [
              "",
              [
                "{
  "version": "0.2",
  "env": {
    "shell": "bash",
    "variables": {
      "PIPELINE_MODE": "release",
      "CODE_ROLLBACK_TARGET": "none",
      "AWS_CLI_VERSION": "2.36.47",
      "GITLEAKS_VERSION": "8.30.1",
      "GITLEAKS_SHA256": "<asset-hash>",
      "PORT_GUARD_NAMES_PARAMETER": "",
                {
                  "Ref": "PortGuardNamesParameterName",
                },
                ""
    },
    "exported-variables": [
      "CODE_CTX"
    ]
  },
  "phases": {
    "install": {
      "commands": [
        "node_version=\\"$(cat .node-version)\\"",
        "node_archive=\\"node-v\${node_version}-linux-arm64.tar.xz\\"",
        "curl -fsSL -o \\"/tmp/\${node_archive}\\" \\"https://nodejs.org/dist/v\${node_version}/\${node_archive}\\"",
        "curl -fsSL \\"https://nodejs.org/dist/v\${node_version}/SHASUMS256.txt\\" | grep \\" \${node_archive}$\\" | (cd /tmp && sha256sum -c -)",
        "mkdir -p /opt/node && tar -xJf \\"/tmp/\${node_archive}\\" -C /opt/node --strip-components=1",
        "curl -fsSL -o /tmp/awscliv2.zip \\"https://awscli.amazonaws.com/awscli-exe-linux-aarch64-\${AWS_CLI_VERSION}.zip\\"",
        "unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install --install-dir /opt/aws-cli --bin-dir /opt/aws-cli/bin",
        "curl -fsSL -o /tmp/gitleaks.tar.gz \\"https://github.com/gitleaks/gitleaks/releases/download/v\${GITLEAKS_VERSION}/gitleaks_\${GITLEAKS_VERSION}_linux_arm64.tar.gz\\"",
        "echo \\"\${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz\\" | sha256sum -c -",
        "mkdir -p /opt/gitleaks && tar -xzf /tmp/gitleaks.tar.gz -C /opt/gitleaks gitleaks",
        "export PATH=\\"/opt/node/bin:/opt/aws-cli/bin:/opt/gitleaks:$PATH\\"",
        "node --version && npm --version && aws --version && gitleaks version && docker buildx version"
      ]
    },
    "pre_build": {
      "commands": [
        "case \\"$PIPELINE_MODE\\" in release|adopt|rollback) echo \\"NOTE: pipeline mode is $PIPELINE_MODE\\" ;; *) echo \\"PIPELINE_MODE must be release, adopt or rollback, got: $PIPELINE_MODE\\" >&2; exit 1;; esac",
        "if [ \\"$PIPELINE_MODE\\" = rollback ] && [ \\"$CODE_ROLLBACK_TARGET\\" != none ]; then [[ \\"$CODE_ROLLBACK_TARGET\\" =~ ^[0-9a-f]{40}$ ]] || { echo \\"CODE_ROLLBACK_TARGET must be a full 40-character commit id, or none, got: $CODE_ROLLBACK_TARGET\\" >&2; exit 1; }; echo \\"NOTE: Code rollback target is $CODE_ROLLBACK_TARGET\\"; elif [ \\"$PIPELINE_MODE\\" != rollback ] && [ \\"$CODE_ROLLBACK_TARGET\\" != none ]; then echo \\"CODE_ROLLBACK_TARGET is only for PIPELINE_MODE=rollback; got $CODE_ROLLBACK_TARGET in mode $PIPELINE_MODE\\" >&2; exit 1; fi"
      ]
    },
    "build": {
      "commands": [
        "RELEASED_SHA=\\"$(aws ssm get-parameter --name /agentx/release/code-released/beta --query Parameter.Value --output text)\\" || { echo \\"port-guard: the last released Code commit could not be read; refusing to run the release\\" >&2; exit 2; }",
        "[[ \\"$RELEASED_SHA\\" =~ ^[0-9a-f]{40}$ ]] || { echo \\"port-guard: the last released Code commit is not recorded; refusing to run the release\\" >&2; exit 2; }",
        "git cat-file -e \\"$RELEASED_SHA^{commit}\\" || { echo \\"port-guard: the last released Code commit is not in this clone; refusing to run the release\\" >&2; exit 2; }",
        "SUPERSEDES_EXEC=none; SUPERSEDES_SHA=none",
        "WAITING_EXEC=\\"$(aws codepipeline get-pipeline-state --name AgentXProductionRelease --query 'stageStates[?stageName==\`Production\`].inboundExecution.pipelineExecutionId | [0]' --output text)\\" || { echo \\"WARN: the execution waiting for Production could not be read; the summary will not name it\\" >&2; WAITING_EXEC=; }",
        "if [[ \\"$WAITING_EXEC\\" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] && [ \\"$WAITING_EXEC\\" != \\"\${EXEC_ID:-}\\" ]; then WAITING_SHA=\\"$(aws codepipeline get-pipeline-execution --pipeline-name AgentXProductionRelease --pipeline-execution-id \\"$WAITING_EXEC\\" --query 'pipelineExecution.artifactRevisions[?name==\`Source\`].revisionId | [0]' --output text)\\" || WAITING_SHA=; [[ \\"$WAITING_SHA\\" =~ ^[0-9a-f]{40}$ ]] || WAITING_SHA=none; SUPERSEDES_EXEC=\\"$WAITING_EXEC\\"; SUPERSEDES_SHA=\\"$WAITING_SHA\\"; echo \\"NOTE: this run replaces the execution $WAITING_EXEC, which is waiting for Production\\"; fi",
        "export CODE_CTX=\\"live:$RELEASED_SHA,target:$CODE_ROLLBACK_TARGET,supersedes:$SUPERSEDES_EXEC,supersedesSha:$SUPERSEDES_SHA\\"",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { HIST_VALUE=\\"$(aws ssm get-parameter --name /agentx/release/code-history/beta --query Parameter.Value --output text)\\" || { echo \\"port-guard: the Code release history could not be read; refusing to run the release\\" >&2; exit 2; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { HIST_FLAT=\\"$(printf '%s' \\"$HIST_VALUE\\" | tr -d ' \\\\t\\\\r\\\\n')\\"; HIST_RE='^\\\\[(\\"[0-9a-f]{40}\\"(,\\"[0-9a-f]{40}\\")*)?\\\\]$'; [[ \\"$HIST_FLAT\\" =~ $HIST_RE ]] || { echo \\"port-guard: the Code release history is not a list of commits; refusing to run the release\\" >&2; exit 2; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { [[ \\"$HIST_FLAT\\" == *\\"\\\\\\"$CODE_ROLLBACK_TARGET\\\\\\"\\"* ]] || { echo \\"port-guard: the rollback target is not in this stage's Code release history; refusing to run the release\\" >&2; exit 2; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { [ \\"$CODE_ROLLBACK_TARGET\\" != \\"$RELEASED_SHA\\" ] || { echo \\"port-guard: the rollback target is the commit already released; refusing to run the release\\" >&2; exit 2; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { git cat-file -e \\"$CODE_ROLLBACK_TARGET^{commit}\\" || { echo \\"port-guard: the rollback target is not in this clone; refusing to run the release\\" >&2; exit 2; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || { git merge-base --is-ancestor \\"$CODE_ROLLBACK_TARGET\\" \\"$RELEASED_SHA\\" || { echo \\"port-guard: the rollback target is not older than the last released commit; refusing to run the release\\" >&2; exit 2; }; }",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || git checkout -q --detach \\"$RELEASED_SHA\\"",
        "git merge-base --is-ancestor \\"$RELEASED_SHA\\" HEAD || { echo \\"port-guard: the last released Code commit is not an ancestor of this commit; refusing to run the release\\" >&2; exit 2; }",
        "[ \\"$(git rev-parse HEAD)\\" = \\"$RELEASED_SHA\\" ] || [ \\"$(git rev-list --parents -n 1 HEAD | wc -w | tr -d ' ')\\" -le 3 ] || { echo \\"port-guard: this commit is an octopus merge ($(( $(git rev-list --parents -n 1 HEAD | wc -w) - 1 )) parents), which the release does not accept. Re-land the change as a normal two-parent merge or as one squash.\\" >&2; exit 2; }",
        "[ \\"$(git rev-parse HEAD)\\" = \\"$RELEASED_SHA\\" ] || [ \\"$(git rev-list --parents -n 1 HEAD | wc -w | tr -d ' ')\\" = 3 ] || [ \\"$(git rev-parse HEAD^1)\\" = \\"$RELEASED_SHA\\" ] || { echo \\"port-guard: this landing has $(git rev-list --count \\"$RELEASED_SHA..HEAD\\") commits on the last released commit that were not merged as one change, so this run does not release them. The next normal merge (a merge commit on top of them) releases them, scanned whole; or re-land the change as one squash or one merge.\\" >&2; exit 2; }",
        "git update-ref refs/heads/release-tip HEAD",
        "git worktree add --detach /tmp/port-guard-trusted \\"$RELEASED_SHA\\"",
        "cd /tmp/port-guard-trusted",
        "set +x",
        "test -n \\"$PORT_GUARD_NAMES_PARAMETER\\" || { echo \\"port-guard: PORT_GUARD_NAMES_PARAMETER is not set; refusing to run without the private name list\\" >&2; exit 2; }",
        "node scripts/port-guard-pipeline.ts --range HEAD..release-tip --allow-guard-edits",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || git update-ref refs/heads/rollback-target \\"$CODE_ROLLBACK_TARGET\\"",
        "[ \\"$CODE_ROLLBACK_TARGET\\" = none ] || node scripts/port-guard-pipeline.ts --range rollback-target..release-tip --allow-guard-edits"
      ]
    }
  }
}",
              ],
            ],
          },
          "Type": "CODEPIPELINE",
