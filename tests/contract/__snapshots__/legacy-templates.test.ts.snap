    "ProductionCodePreflightRoleDefaultPolicy0BE61DCB": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "ReleaseBuildLogsD2C04AA9",
