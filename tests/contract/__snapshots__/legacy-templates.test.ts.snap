            "Fn::GetAtt": [
              "DeveloperTaskNotifierNoticeDeadLetterQueue3C87E1D7",
              "Arn",
            ],
          },
          "maxReceiveCount": 100,
        },
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 180,
      },
      "Type": "AWS::SQS::Queue",
