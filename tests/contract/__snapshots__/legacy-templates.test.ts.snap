        "FilterCriteria": {
          "Filters": [
            {
              "Pattern": "{"dynamodb":{"NewImage":{"entityType":{"S":["DEVELOPER_TASK","DEVELOPER_TASK_POINTER"]}}}}",
            },
            {
              "Pattern": "{"dynamodb":{"NewImage":{"entityType":{"S":["OPERATION"]},"status":{"S":["SUCCEEDED","FAILED","CANCELLED","INTERRUPTED"]}}}}",
            },
            {
              "Pattern": "{"dynamodb":{"NewImage":{"entityType":{"S":["ADMIN_CHANGE"]}}}}",
            },
            {
              "Pattern": "{"dynamodb":{"NewImage":{"entityType":{"S":["WORKFLOW_ACTION_REFUSAL","TASK_COMMENT_NUDGE","TASK_PEOPLE_NOTIFICATION"]}}}}",
            },
            {
              "Pattern": "{"eventName":["INSERT"],"dynamodb":{"NewImage":{"entityType":{"S":["OUTBOX"]},"pk":{"S":[{"prefix":"ORG#"}]},"outboxState":{"S":[{"exists":true}]}}}}",
