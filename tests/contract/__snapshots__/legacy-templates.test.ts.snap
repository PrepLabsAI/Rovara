exports[`legacy production templates > AgentXProductionRuntime is unchanged 1`] = `
{
  "Conditions": {
    "HasAnthropicSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AnthropicSecretArn",
            },
            "",
          ],
        },
      ],
    },
    "HasOpenAISecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "OpenAISecretArn",
            },
            "",
          ],
        },
      ],
    },
    "HasOpenRouterProviders": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "OpenRouterProviders",
            },
            "",
          ],
        },
      ],
    },
    "HasOpenRouterSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "OpenRouterSecretArn",
            },
            "",
          ],
        },
      ],
    },
  },
  "Description": "AgentX worker image and model settings for EC2 workers",
  "Parameters": {
    "AnthropicSecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw Anthropic API key",
      "Type": "String",
    },
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
    "E2eAgentModelId": {
      "AllowedPattern": "^(default|[A-Za-z0-9][A-Za-z0-9._:/-]{0,199})$",
      "Default": "default",
      "Description": "AI navigation model for browser checks: default (Rovara's recommendation) or an eligible model id",
      "Type": "String",
    },
    "ExecutorImageUri": {
      "AllowedPattern": "^(none|.+@sha256:[a-f0-9]{64})$",
      "Default": "none",
      "Description": "Immutable private ECR linux/arm64 browser executor image URI, or none",
      "Type": "String",
    },
    "ModelFallback": {
      "AllowedPattern": "^(none|[A-Za-z0-9][A-Za-z0-9._:-]{0,79})$",
      "Default": "none",
      "Description": "Bedrock model used when a provider key secret is missing: none, or a Bedrock model id",
      "Type": "String",
    },
    "ModelId": {
      "Description": "pi model identifier available in the deployment region",
      "Type": "String",
    },
    "ModelProvider": {
      "Default": "amazon-bedrock",
      "Description": "pi model provider identifier",
      "Type": "String",
    },
    "OpenAISecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw OpenAI API key",
      "Type": "String",
    },
    "OpenRouterProviders": {
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9_/-]{0,79}(,[a-z0-9][a-z0-9_/-]{0,79})*$",
      "Default": "",
      "Description": "Optional comma-separated OpenRouter provider allowlist; fallbacks are disabled",
      "Type": "String",
    },
    "OpenRouterSecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw OpenRouter API key",
      "Type": "String",
    },
    "PromptCacheRetention": {
      "AllowedValues": [
        "short",
        "long",
      ],
      "Default": "long",
      "Description": "Bedrock prompt-cache retention mode used by pi",
      "Type": "String",
    },
    "WorkerImageUri": {
      "AllowedPattern": "^.+@sha256:[a-f0-9]{64}$",
      "Description": "Immutable private ECR linux/arm64 worker image URI",
      "Type": "String",
    },
  },
  "Resources": {
    "WorkerAnthropicSecretParameterFA40843B": {
      "Properties": {
        "Description": "AgentX worker anthropicSecretArn for EC2 workers",
        "Name": "/agentx/production/worker-anthropic-secret-arn",
        "Type": "String",
        "Value": {
          "Fn::If": [
            "HasAnthropicSecret",
            {
              "Ref": "AnthropicSecretArn",
            },
            "none",
          ],
        },
      },
      "Type": "AWS::SSM::Parameter",
    },
    "WorkerE2eAgentModelParameter3B6AA65C": {
      "Properties": {
        "Description": "AgentX worker e2eAgentModel for EC2 workers",
        "Name": "/agentx/production/worker-e2e-agent-model",
        "Type": "String",
        "Value": {
          "Ref": "E2eAgentModelId",
        },
      },
      "Type": "AWS::SSM::Parameter",
    },
    "WorkerExecutorImageParameter4915196F": {
      "Properties": {
        "Description": "AgentX worker executorImage for EC2 workers",
        "Name": "/agentx/production/worker-executor-image",
        "Type": "String",
        "Value": {
          "Ref": "ExecutorImageUri",
        },
      },
      "Type": "AWS::SSM::Parameter",
    },
    "WorkerImageParameter7CA9ADBB": {
      "Properties": {
        "Description": "AgentX worker image URI pinned by digest, for EC2 workers",
        "Name": "/agentx/production/worker-image",
        "Type": "String",
        "Value": {
          "Ref": "WorkerImageUri",
        },
      },
      "Type": "AWS::SSM::Parameter",
    },
    "WorkerModelFallbackParameter4DCAF22C": {
      "Properties": {
        "Description": "AgentX worker modelFallback for EC2 workers",
        "Name": "/agentx/production/worker-model-fallback",
        "Type": "String",
        "Value": {
          "Ref": "ModelFallback",
        },
      },
      "Type": "AWS::SSM::Parameter",
    },
    "WorkerModelIdParameter02DE997A": {
