    "SessionsStuckProvisioningAlarm53058404": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "An EC2 session provisioning ended without finishing and was marked failed by the reconciler. Open the provisioner execution named in the reconciler's logs.",
        "AlarmName": "AgentXReconcilerStuckProvisioning",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "ReconcilerStuckProvisioning",
        "Namespace": "AgentX",
        "Period": 900,
        "Statistic": "Maximum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SlackDeadLettersAlarm9EF9F079": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "A Slack request exhausted its receives and is in the Slack request dead-letter queue. Check the Slack orchestrator logs for its event ID.",
        "AlarmName": "AgentXSlackDeadLetters",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "SlackRequestDeadLetterQueueBBBDDF4E",
                "QueueName",
              ],
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "Period": 300,
        "Statistic": "Maximum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
