    "SessionsStuckCancelsAlarmF9D26618": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "The reconciler found a task whose cancel never reached its worker, and queued the cancel again or ended the task (or failed to). Check the reconciler's logs for stuck_cancel events: a retried cancel that finishes, or an ended task, needs no action; repeated ones point at a dispatch or worker fault.",
        "AlarmName": "AgentXStuckCancels",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "FILL(retries, 0) + FILL(ended, 0) + FILL(interrupted, 0) + FILL(failures, 0) + FILL(unretried, 0)",
            "Id": "expr_1",
            "Label": "Stuck cancels retried, ended, failed or unretried",
            "ReturnData": true,
          },
          {
            "Id": "retries",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerStuckCancelRetries",
                "Namespace": "AgentX",
              },
              "Period": 900,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
          {
            "Id": "ended",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerStuckCancelsEnded",
                "Namespace": "AgentX",
              },
              "Period": 900,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
          {
            "Id": "interrupted",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerStuckCancelsInterrupted",
                "Namespace": "AgentX",
              },
              "Period": 900,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
          {
            "Id": "failures",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerStuckCancelFailures",
                "Namespace": "AgentX",
              },
              "Period": 900,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
          {
            "Id": "unretried",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerStuckCancelsUnretried",
                "Namespace": "AgentX",
              },
              "Period": 900,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SessionsStuckProvisioningAlarm53058404": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "An EC2 session provisioning ended without finishing and was marked failed by the reconciler. Open the provisioner execution named in the reconciler's logs.",
        "AlarmName": "AgentXReconcilerStuckProvisioning",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "ReconcilerStuckProvisioning",
        "Namespace": "AgentX",
        "Period": 900,
        "Statistic": "Maximum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SessionsUnwaitedTaskFailuresAlarm622E7972": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "The reconciler could not check or cancel Slack tasks idle over 24 hours with nobody waiting, on two runs in a row. Check the reconciler's logs for unwaited_task.cancel_failed, unwaited_task.read_failed and reconciler.unwaited_task_sweep_failed.",
        "AlarmName": "AgentXUnwaitedTaskFailures",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 2,
        "Metrics": [
          {
            "Expression": "FILL(cancels, 0) + FILL(reads, 0)",
            "Id": "expr_1",
            "Label": "Unwaited task cancel and read failures",
            "ReturnData": true,
          },
          {
            "Id": "cancels",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerUnwaitedTaskFailures",
                "Namespace": "AgentX",
              },
              "Period": 600,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
          {
            "Id": "reads",
            "MetricStat": {
              "Metric": {
                "MetricName": "ReconcilerUnwaitedTaskReadFailures",
                "Namespace": "AgentX",
              },
              "Period": 600,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
