                "enabled",
                "disabled",
              ],
            },
            "CONTROL_PLANE_URL": {
              "Fn::GetAtt": [
                "HttpApi",
                "ApiEndpoint",
              ],
            },
            "NOTICE_QUEUE_URL": {
              "Ref": "DeveloperTaskNotifierNoticeQueue56CA42FC",
