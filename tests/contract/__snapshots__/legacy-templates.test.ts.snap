                  "Ref": "SlackCompanyTeamId",
                },
              },
              {
                "Name": "AGENTX_ENV",
                "Value": "production",
              },
              {
                "Name": "COMPANY_SIGNIN",
                "Value": {
                  "Ref": "CompanySignIn",
                },
              },
              {
                "Name": "SLACK_COMPANY_TOKEN_ROLE_ARN",
                "Value": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":role/agentx-production-slk",
                    ],
                  ],
                },
              },
              {
                "Name": "SLACK_COMPANY_TOKEN_FALLBACK",
                "Value": "shared",
              },
            ],
            "Essential": true,
            "Image": {
              "Ref": "OrchestratorImageUri",
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs6819BB44",
                },
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "orchestrator",
              },
            },
            "Name": "orchestrator",
            "StopTimeout": 120,
          },
        ],
        "Cpu": "512",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole605A040B",
            "Arn",
          ],
        },
        "Family": "agentx-slack-orchestrator",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE",
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX",
        },
        "TaskRoleArn": {
          "Ref": "TaskRoleArn",
        },
      },
      "Type": "AWS::ECS::TaskDefinition",
    },
    "TestAlarm5A9EF6BD": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
        "AlarmDescription": "agentx alerts test sets this alarm to ALARM and back to OK. It never fires on its own.",
        "AlarmName": "AgentXTestAlarm",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "TestAlarmNeverEmitted",
        "Namespace": "AgentX",
        "Period": 300,
        "Statistic": "Sum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "TurnErrorsAlarm88205A44": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
        "AlarmDescription": "An orchestrator turn failed. Export recent turns with agentx admin turns export --since 1h.",
        "AlarmName": "AgentXTurnErrors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "TurnFailed",
        "Namespace": "AgentX",
        "Period": 300,
        "Statistic": "Sum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
