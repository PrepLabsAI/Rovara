                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
                    },
                    ":codebuild:us-east-1:",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":report-group/",
                    {
                      "Ref": "ProductionCodePreflight8A80CA9E",
                    },
                    "-*",
                  ],
                ],
              },
            },
            {
              "Action": "codepipeline:DisableStageTransition",
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":codepipeline:us-east-1:",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":AgentXProductionRelease/Production",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":codepipeline:us-east-1:",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":AgentXProductionRelease",
                    ],
                  ],
                },
              ],
              "Sid": "ClosePromotionGate",
            },
            {
              "Action": "ssm:GetParameter",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
                    },
                    ":ssm:us-east-1:",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":parameter",
                    {
                      "Ref": "PortGuardNamesParameterName",
                    },
                  ],
                ],
              },
              "Sid": "ReadPortGuardNames",
            },
            {
              "Action": "kms:Decrypt",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "ssm.us-east-1.amazonaws.com",
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Ref": "PortGuardNamesKeyArn",
              },
              "Sid": "DecryptPortGuardNames",
            },
            {
              "Action": "ssm:GetParameter",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
