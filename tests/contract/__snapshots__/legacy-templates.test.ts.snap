    "SessionsDeleterB48741EA": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "SessionsDeleterRoleDefaultPolicyFB89AE1E",
        "SessionsDeleterRole5691AEAE",
      ],
      "Properties": {
        "DefinitionString": {
          "Fn::Join": [
            "",
            [
              "{"Comment":"Deletes a closed ec2-ebs workspace's instance and volume","QueryLanguage":"JSONata","StartAt":"Start","States":{"Start":{"Type":"Pass","Assign":{"workspaceId":"{% $states.input.workspaceId %}","instanceId":"{% $states.input.instanceId %}","volumeId":"{% $states.input.volumeId %}","waits":0,"lastError":null},"Next":"HasInstance"},"HasInstance":{"Type":"Choice","Choices":[{"Condition":"{% $instanceId != null %}","Next":"TerminateInstance"}],"Default":"HasVolume"},"TerminateInstance":{"Type":"Task","Resource":"arn:aws:states:::aws-sdk:ec2:terminateInstances","Arguments":{"InstanceIds":["{% $instanceId %}"]},"Retry":[{"ErrorEquals":["States.ALL"],"IntervalSeconds":2,"MaxAttempts":3,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"InstanceAlreadyGone","Assign":{"lastError":"{% $states.errorOutput %}"}}],"Next":"WaitForTermination"},"InstanceAlreadyGone":{"Type":"Choice","Choices":[{"Condition":"{% $contains($string($lastError.Error) & ' ' & $string($lastError.Cause), 'InvalidInstanceID.NotFound') or $contains($string($lastError.Error) & ' ' & $string($lastError.Cause), 'does not exist') %}","Next":"HasVolume"}],"Default":"DeletionFailed"},"WaitForTermination":{"Type":"Wait","Seconds":10,"Next":"DescribeInstance"},"DescribeInstance":{"Type":"Task","Resource":"arn:aws:states:::aws-sdk:ec2:describeInstances","Arguments":{"InstanceIds":["{% $instanceId %}"]},"Assign":{"instanceState":"{% $states.result.Reservations[0].Instances[0].State.Name %}","waits":"{% $waits + 1 %}"},"Retry":[{"ErrorEquals":["States.ALL"],"IntervalSeconds":2,"MaxAttempts":3,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"InstanceAlreadyGone","Assign":{"lastError":"{% $states.errorOutput %}"}}],"Next":"InstanceTerminated"},"InstanceTerminated":{"Type":"Choice","Choices":[{"Condition":"{% $instanceState = 'terminated' %}","Next":"HasVolume"},{"Condition":"{% $waits < 60 %}","Next":"WaitForTermination"}],"Default":"DeletionFailed"},"HasVolume":{"Type":"Choice","Choices":[{"Condition":"{% $volumeId != null %}","Next":"ResetWaits"}],"Default":"MarkDeleted"},"ResetWaits":{"Type":"Pass","Assign":{"waits":0},"Next":"WaitForDetach"},"WaitForDetach":{"Type":"Wait","Seconds":5,"Next":"DescribeVolume"},"DescribeVolume":{"Type":"Task","Resource":"arn:aws:states:::aws-sdk:ec2:describeVolumes","Arguments":{"VolumeIds":["{% $volumeId %}"]},"Assign":{"volumeState":"{% $states.result.Volumes[0].State %}","waits":"{% $waits + 1 %}"},"Retry":[{"ErrorEquals":["States.ALL"],"IntervalSeconds":2,"MaxAttempts":3,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"VolumeAlreadyGone","Assign":{"lastError":"{% $states.errorOutput %}"}}],"Next":"VolumeDetached"},"VolumeAlreadyGone":{"Type":"Choice","Choices":[{"Condition":"{% $contains($string($lastError.Error) & ' ' & $string($lastError.Cause), 'InvalidVolume.NotFound') or $contains($string($lastError.Error) & ' ' & $string($lastError.Cause), 'does not exist') %}","Next":"MarkDeleted"}],"Default":"DeletionFailed"},"VolumeDetached":{"Type":"Choice","Choices":[{"Condition":"{% $volumeState = 'available' %}","Next":"DeleteVolume"},{"Condition":"{% $volumeState = 'deleted' or $volumeState = 'deleting' %}","Next":"MarkDeleted"},{"Condition":"{% $waits < 60 %}","Next":"WaitForDetach"}],"Default":"DeletionFailed"},"DeleteVolume":{"Type":"Task","Resource":"arn:aws:states:::aws-sdk:ec2:deleteVolume","Arguments":{"VolumeId":"{% $volumeId %}"},"Retry":[{"ErrorEquals":["States.ALL"],"IntervalSeconds":2,"MaxAttempts":3,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"VolumeAlreadyGone","Assign":{"lastError":"{% $states.errorOutput %}"}}],"Next":"MarkDeleted"},"MarkDeleted":{"Type":"Task","Resource":"arn:aws:states:::lambda:invoke","Arguments":{"FunctionName":"",
              {
                "Fn::GetAtt": [
                  "SessionsSteps3B98DD2B",
                  "Arn",
                ],
              },
              "","Payload":{"action":"markDeleted","workspaceId":"{% $workspaceId %}"}},"Retry":[{"ErrorEquals":["States.ALL"],"IntervalSeconds":2,"MaxAttempts":3,"BackoffRate":2}],"Next":"Deleted"},"Deleted":{"Type":"Succeed"},"DeletionFailed":{"Type":"Fail","Error":"DeletionFailed","Cause":"{% $string($lastError) %}"}}}",
            ],
          ],
        },
        "LoggingConfiguration": {
          "Destinations": [
            {
              "CloudWatchLogsLogGroup": {
                "LogGroupArn": {
                  "Fn::GetAtt": [
                    "SessionsDeleterLogs661C84D6",
                    "Arn",
                  ],
                },
              },
            },
          ],
          "IncludeExecutionData": false,
          "Level": "ERROR",
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "SessionsDeleterRole5691AEAE",
            "Arn",
          ],
        },
      },
      "Type": "AWS::StepFunctions::StateMachine",
      "UpdateReplacePolicy": "Delete",
    },
    "SessionsDeleterFailuresAlarm55CFD4E0": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "An EC2 session deleter execution failed or timed out. Open its execution in Step Functions for the failing step.",
        "AlarmName": "AgentXSessionDeleterFailures",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
