                      "ApiEndpoint",
                    ],
                  },
                  "/v1/slack/channel-events",
                ],
              ],
            },
            "BUILT_IN_ADAPTER_CHANNEL": "slack",
            "BUILT_IN_ADAPTER_COMMANDS_URL": {
              "Fn::Join": [
                "",
                [
                  {
                    "Fn::GetAtt": [
                      "HttpApi",
                      "ApiEndpoint",
                    ],
                  },
                  "/v1/slack/channel-commands",
