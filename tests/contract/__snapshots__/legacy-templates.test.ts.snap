            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "An EC2 session provisioner execution failed or timed out. Open its execution in Step Functions for the failing step.",
        "AlarmName": "AgentXSessionProvisionerFailures",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "FILL(failed, 0) + FILL(timedOut, 0)",
            "Id": "expr_1",
            "ReturnData": true,
          },
          {
            "Id": "failed",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "StateMachineArn",
                    "Value": {
                      "Ref": "SessionsProvisioner9C44055B",
                    },
                  },
                ],
                "MetricName": "ExecutionsFailed",
                "Namespace": "AWS/States",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "timedOut",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "StateMachineArn",
                    "Value": {
                      "Ref": "SessionsProvisioner9C44055B",
                    },
                  },
                ],
                "MetricName": "ExecutionsTimedOut",
                "Namespace": "AWS/States",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
