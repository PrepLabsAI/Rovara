    "SlackCompanyTokenReaderRole3917AFD9": {
      "Condition": "SlackCompanyModeOnBF1D0D56",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession",
              ],
              "Condition": {
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "rovara:org",
                  ],
                },
                "Null": {
                  "aws:RequestTag/rovara:org": "false",
                  "aws:TagKeys": "false",
                  "sts:TransitiveTagKeys": "true",
                },
                "StringLike": {
                  "aws:RequestTag/rovara:org": "org_????????????????????",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "SlackOrchestratorTaskRole2372FE40",
                    "Arn",
                  ],
                },
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "The hosted Slack service acting for one company: that company's Slack bot token only (session tag rovara:org)",
        "RoleName": "agentx-production-slk",
      },
      "Type": "AWS::IAM::Role",
    },
    "SlackDeadLettersAlarm9EF9F079": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "A Slack request exhausted its receives and is in the Slack request dead-letter queue. Check the Slack orchestrator logs for its event ID.",
        "AlarmName": "AgentXSlackDeadLetters",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "SlackRequestDeadLetterQueueBBBDDF4E",
                "QueueName",
              ],
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "Period": 300,
        "Statistic": "Maximum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SlackEventsRoute": {
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi",
        },
        "AuthorizationType": "NONE",
        "RouteKey": "POST /v1/slack/events",
        "Target": {
          "Fn::Join": [
            "",
            [
              "integrations/",
              {
                "Ref": "SlackIngressIntegration",
              },
            ],
          ],
        },
      },
      "Type": "AWS::ApiGatewayV2::Route",
    },
    "SlackHandOffFailureQueue0ACCAF94": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete",
    },
    "SlackHandOffFailuresAlarm4D063F81": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "An AgentX background request (a Slack button press or a scheduled retry) was lost: Lambda could not run it, and it is in the Slack hand-off failure queue. Check the queue, and the broker and Slack ingress logs for its task or request ID.",
        "AlarmName": "AgentXSlackHandOffFailures",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "SlackHandOffFailureQueue0ACCAF94",
                "QueueName",
              ],
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "NumberOfMessagesSent",
        "Namespace": "AWS/SQS",
        "Period": 300,
        "Statistic": "Sum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SlackIngress5C88FFA0": {
      "DependsOn": [
        "SlackIngressServiceRoleDefaultPolicy6F2F26FC",
        "SlackIngressServiceRole8DA92EC7",
      ],
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Fn::Sub": "cdk-hnb659fds-assets-\${AWS::AccountId}-\${AWS::Region}",
          },
          "S3Key": "<asset-hash>.zip",
        },
        "Environment": {
          "Variables": {
            "ADMIN_CHANGES": "enabled",
            "AGENTX_ENV": {
              "Fn::If": [
                "SlackCompanyModeOnBF1D0D56",
                "production",
                "",
              ],
            },
            "BROKER_FUNCTION_NAME": {
              "Ref": "BrokerE1355FD6",
            },
            "CHANNEL_API_URL": {
              "Fn::GetAtt": [
                "HttpApi",
                "ApiEndpoint",
              ],
            },
            "COMPANY_SIGNIN": {
              "Fn::If": [
                "CompanySignInSwitchOn6E5AE93A",
                "enabled",
                "disabled",
              ],
            },
            "DEVELOPER_SIGNIN_TABLE_NAME": {
              "Fn::If": [
                "SlackCompanyModeOnBF1D0D56",
                {
                  "Ref": "DeveloperSignInTable26CE739E",
                },
                "",
              ],
            },
            "SHARED_TASKS": "enabled",
            "SLACK_ADAPTER_SECRET_NAME": "agentx/production/channel-adapter/slack",
            "SLACK_APP_POSTED_MESSAGES": {
              "Ref": "SlackAppPostedMessages",
            },
            "SLACK_COMPANY_WORKSPACES": {
              "Fn::If": [
                "SlackCompanyModeOnBF1D0D56",
                "enabled",
                "disabled",
              ],
            },
            "SLACK_REQUEST_QUEUE_URL": {
              "Ref": "SlackRequestQueueCC82C864",
            },
            "SLACK_SECRET_ARN": {
              "Ref": "SlackSecretEA96F13F",
            },
            "SLACK_TEAM_ID": {
              "Fn::If": [
                "SlackCompanyModeOnBF1D0D56",
                {
                  "Ref": "SlackTeamId",
                },
                "",
              ],
            },
            "SLACK_THREADS_TABLE_NAME": {
              "Ref": "SlackThreads36E14C1E",
            },
            "SLACK_THREAD_TURNS_PER_MINUTE": {
              "Ref": "SlackThreadTurnsPerMinute",
            },
            "SLACK_VIA_CHANNEL": {
              "Ref": "SlackViaChannel",
            },
            "STATE_TABLE_NAME": {
              "Ref": "State1C20CC9A",
            },
            "TURN_RECORDS_TABLE_NAME": {
              "Ref": "TurnRecords69ECFCD9",
            },
          },
        },
        "Handler": "index.handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "SlackIngressLogs5D31BE54",
          },
        },
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "SlackIngressServiceRole8DA92EC7",
            "Arn",
          ],
        },
        "Runtime": "nodejs22.x",
        "Timeout": 30,
        "TracingConfig": {
          "Mode": "Active",
        },
      },
      "Type": "AWS::Lambda::Function",
    },
