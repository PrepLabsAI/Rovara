{
  "openapi": "3.0.3",
  "info": {
    "title": "GitHub v3 REST API",
    "version": "1.1.4"
  },
  "paths": {
    "/repos/{owner}/{repo}/issues": {
      "get": {
        "operationId": "issues/list-for-repo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/issue"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "issues/create",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/issue"
                }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/issues/{issue_number}": {
      "get": {
        "operationId": "issues/get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/issue"
                }
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/issues/{issue_number}/comments": {
      "get": {
        "operationId": "issues/list-comments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/issue-comment"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "issues/create-comment",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/issue-comment"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "issue": {
        "type": "object",
        "required": [
          "assignee",
          "closed_at",
          "comments",
          "comments_url",
          "events_url",
          "html_url",
          "id",
          "node_id",
          "labels",
          "labels_url",
          "milestone",
          "number",
          "repository_url",
          "state",
          "locked",
          "title",
          "url",
          "user",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "assignee": {},
          "closed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "comments": {
            "type": "integer"
          },
          "comments_url": {
            "type": "string",
            "format": "uri"
          },
          "events_url": {
            "type": "string",
            "format": "uri"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "node_id": {
            "type": "string"
          },
          "labels": {
            "type": "array"
          },
          "labels_url": {
            "type": "string"
          },
          "milestone": {},
          "number": {
            "type": "integer"
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "state": {
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "user": {},
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "issue-comment": {
        "type": "object",
        "required": [
          "id",
          "node_id",
          "html_url",
          "issue_url",
          "user",
          "url",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "node_id": {
            "type": "string"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          },
          "issue_url": {
            "type": "string",
            "format": "uri"
          },
          "user": {},
          "url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "x-rovara-not-extracted-paths": [
    "/repos/{owner}/{repo}/issues/comments",
    "/repos/{owner}/{repo}/issues/comments/{comment_id}",
    "/repos/{owner}/{repo}/issues/events",
    "/repos/{owner}/{repo}/issues/events/{event_id}"
  ]
}
