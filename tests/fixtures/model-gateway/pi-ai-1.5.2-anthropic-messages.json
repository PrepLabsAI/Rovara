{
  "model": "claude-sonnet-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Read the project README.",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    }
  ],
  "max_tokens": 64,
  "stream": true,
  "system": [
    {
      "type": "text",
      "text": "You are a coding assistant.",
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "tools": [
    {
      "name": "read",
      "description": "Read a file.",
      "eager_input_streaming": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ]
}
