# Per-Dockerfile ignore (BuildKit). It REPLACES the repository .dockerignore, which
# excludes node_modules/ and dist/ — both of which this image genuinely needs.
.git
.superpowers
coverage
cdk.out
.env*
*.log*
**/*.tsbuildinfo
docs
tests
infra
packages/cli
packages/*/src
# Build and cloud tooling the isolated worker never runs.
node_modules/.cache
node_modules/.bin
node_modules/aws-cdk
node_modules/aws-cdk-lib
node_modules/@aws-cdk
node_modules/@aws-sdk
node_modules/typescript
node_modules/@rolldown
node_modules/vitest
node_modules/@vitest
node_modules/esbuild
node_modules/@esbuild
node_modules/eslint
node_modules/@typescript-eslint
