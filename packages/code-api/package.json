      "default": "./dist/errors.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "peerDependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "zod": "4.6.6"
  }
}
