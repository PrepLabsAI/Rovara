{"schemaVersion":"e2e-application-runtime-probe/v1","probeId":"app-host-denial/v1","kind":"api","polarity":"positive","templateId":"app-host-denial/v1","requiredCapabilities":["http","network-denial"],"oracle":{"kind":"protected-network-denial","requiresKernelDenialCounter":true,"requiresAbsenceOfEffect":true,"candidateResponseIsNotEvidence":true,"appStart":{"program":"node","args":["--input-type=module","-e","import{readFileSync as f}from'node:fs';import{connect as c}from'node:net';const r=f('/proc/net/route','utf8').split('\\n').slice(1).map(l=>l.split('\\t')).find(x=>x[1]!=='00000000'&&x[2]==='00000000');if(!r)process.exit(3);const n=parseInt(r[1],16),s=c({host:[n&255,n>>8&255,n>>16&255,(n>>>24)+1].join('.'),port:8080,timeout:3000});s.on('timeout',()=>{s.destroy();import('./server.mjs').then(m=>m.startOrdersServer())}).on('connect',()=>process.exit(3)).on('error',()=>process.exit(3))"]}}}
