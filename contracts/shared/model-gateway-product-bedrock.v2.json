{
  "version": 2,
  "bridge": "model-gateway-product-ai.v1.json",
  "provider": {
    "name": "bedrock",
    "upstreamHost": "bedrock-runtime.{region}.amazonaws.com",
    "paths": [
      "/v1/product/bedrock/model/{model}/converse",
      "/v1/product/bedrock/model/{model}/converse-stream",
      "/v1/product/bedrock/model/{model}/invoke",
      "/v1/product/bedrock/model/{model}/invoke-with-response-stream"
    ],
    "model": "^[a-z0-9][a-z0-9.:-]{1,200}$",
    "operations": {
      "converse": "every picked model",
      "converse-stream": "every picked model",
      "invoke": "Claude (Anthropic body) and Titan text embeddings",
      "invoke-with-response-stream": "Claude (Anthropic body)"
    },
    "sandbox": {
      "endpointEnvironment": "AWS_ENDPOINT_URL_BEDROCK_RUNTIME",
      "credentials": "dummy"
    },
    "streamContentType": "application/vnd.amazon.eventstream",
    "workerRemovesHeaders": [
      "authorization",
      "x-amz-security-token",
      "x-amz-date",
      "x-amz-content-sha256"
    ],
    "gatewayRefusesHeaders": [
      "authorization",
      "x-amz-security-token",
      "x-amz-bedrock-*",
      "x-amzn-bedrock-*"
    ],
    "workerRemovesQuery": []
  },
  "refusals": [
    {
      "status": 400,
      "type": "not_allowed",
      "message": "this Bedrock feature is not offered on the product route: guardrails, priority or latency tiers, provisioned throughput and application inference profiles are refused"
    },
    {
      "status": 400,
      "type": "not_allowed",
      "message": "this model is not one your company picked for its Bedrock connection"
    },
    {
      "status": 400,
      "type": "not_allowed",
      "message": "this model is not offered this way on the product route: Converse for every picked model, InvokeModel only for Claude's Anthropic body and Titan text embeddings"
    },
    {
      "status": 404,
      "type": "not_set_up",
      "message": "no Bedrock role is connected for this project"
    },
    {
      "status": 403,
      "type": "model_not_enabled",
      "message": "this model is not enabled yet in your AWS account: an AWS admin opens it once in the Bedrock console, then try again"
    },
    {
      "status": 502,
      "type": "product_key_refused",
      "message": "not run: AWS refused the connected role (check the Bedrock connection in Settings)"
    },
    {
      "status": 429,
      "type": "provider_limited",
      "message": "Bedrock is limiting this account; try again later"
    },
    {
      "status": 429,
      "type": "provider_quota",
      "message": "the Bedrock quota for this account is used up"
    },
    {
      "status": 400,
      "type": "provider_refused",
      "message": "the provider refused this request"
    },
    {
      "status": 503,
      "type": "unavailable",
      "message": "model access unavailable"
    }
  ]
}
